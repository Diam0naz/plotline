# ── Plotline environment variables (copy to .env and fill in) ─────────────────
# The server reads these directly from the process environment; there is no dotenv
# loader in this zero-dependency build — export them or use `neon deploy`/your
# host's env editor. Never commit a real .env (see .gitignore).

# ── The server ─────────────────────────────────────────────────────────────────
# HTTP port (default 8123)
PORT=8123
# Where the append-only ledgers and auth files live (default ./data)
DATA_DIR=./data

# ── Roles and access ───────────────────────────────────────────────────────────
# Operator API token (Bearer). Printed at startup if unset.
ADMIN_TOKEN=
# Console sign-in password for the `admin` account. If unset, the ADMIN_TOKEN
# above is the password (the server tells you this at boot).
ADMIN_PASSWORD=
# Optional key required on POST /api/anchor (Bearer). Farmer phones store it with
# "Ledger key…" in the app. Unset keeps the endpoint open but rate-limited.
ANCHOR_API_KEY=

# ── Cache (optional) ───────────────────────────────────────────────────────────
# Read-through cache for public registry views. Missing/dying Redis = uncached,
# and the app still runs. Set to "off" to disable explicitly.
# REDIS_URL=redis://localhost:6379

# ── In-code integrations ───────────────────────────────────────────────────────
# Solana RPC for publishing the hash-chained log head (neon.ts / anchor-publish).
# Unset = dry-run mode for /api/anchor/publish.
# SOLANA_RPC_URL=
# SentinelHub token for a real NDVI provider (server/ndvi.mjs stub placeholder).
# SENTINELHUB_TOKEN=

# ── Neon (filled in by `neon deploy` into .env.local — leave empty here) ───────
# API key for the neon CLI during setup (not needed at app runtime).
# Get one at console.neon.tech → API Keys. Real keys look like: nvapi-…
# NEON_API_KEY=
# Postgres/Lakebase connection string for the branch compute (written by deploy).
# DATABASE_URL=
# Written by `neon deploy` for Neon Auth / Functions / Realtime once provisioned.
# NEON_AUTH_*
# NEON_FUNCTIONS_*
# NEON_REALTIME_*
